# ─────────────────────────────────────────────────────────────────────────────
# Docker image build configuration (webapp: Vite build → nginx runtime)
#
# Read by the `docker-*` targets in ../Makefile (via `-include`). Edit the
# values here rather than in the Makefile. Anything can still be overridden for
# a single run on the command line, e.g.:
#
#     make docker-build VERSION=0.1.0
#     make docker-build PLATFORMS=linux/arm64 PUSH=      # arm only, don't push
#
# The command the targets ultimately run is, effectively:
#
#     docker buildx build --builder $(BUILDER) --network=$(NETWORK) \
#       --platform=$(PLATFORMS) \
#       -t $(IMAGE):$(TAG_PREFIX)$(VERSION) \
#       -f $(DOCKERFILE) $(CONTEXT) $(NO_CACHE) $(PUSH)
# ─────────────────────────────────────────────────────────────────────────────

# Image repository: registry[/namespace]/name, WITHOUT a tag.
IMAGE := devlit/our-journey

# Final tag = TAG_PREFIX + version, e.g. `v-0.0.1`.
TAG_PREFIX := v-

# Version offered as the default when `make docker-build` prompts for one.
# `make docker-build` writes the version you pick — from the prompt or from
# VERSION=… — back into this line, so the default advances to your last build.
DEFAULT_VERSION := 0.0.1

# Multi-arch target platforms passed to `docker buildx --platform`.
PLATFORMS := linux/amd64,linux/arm64

# Dockerfile and build context, relative to this dir (where the Makefile is).
DOCKERFILE := docker/Dockerfile
CONTEXT    := .

# The API base URL — and any other VITE_* build values — now live in .env.prod,
# which the Dockerfile copies to .env before `npm run build`. That file is the
# single source of truth for what gets baked into the bundle; edit it to change
# the API origin. There is deliberately no VITE_API_BASE_URL build-arg anymore —
# a stale value here is exactly what baked the wrong API host into a past image.

# Dedicated buildx builder (shared with the API repo). A multi-platform build
# cannot run on the default `docker` driver, so the targets create this
# docker-container builder on demand instead of hijacking your current one. It
# is created with the host-network entitlement so `NETWORK := host` works; if
# host networking ever fails, remove it and let it be recreated:
#     docker buildx rm $(BUILDER)
BUILDER := maefp-builder

# Build-time network for RUN steps. `host` needs the buildkit host-network
# entitlement, which the builder above grants and the build passes via --allow.
NETWORK := host

# Build flags. Blank either one to drop it:
#   make docker-build NO_CACHE=        # reuse the layer cache
#   make docker-build PUSH=            # build only, don't push to the registry
NO_CACHE := --no-cache
PUSH     := --push
