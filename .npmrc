# typescript-eslint@8 still declares `typescript@>=4.8.4 <6.1.0` as a peer, but this
# project is on TypeScript 7 (see devDependencies). No published typescript-eslint
# release supports TS 7 yet, so npm's strict peer resolution fails on install.
# typescript-eslint is lint-only and is not part of `npm run build`, so accepting the
# mismatch is safe. Bun (the previous package manager) ignored peer ranges by default,
# so this restores the same dependency tree. Remove once typescript-eslint supports TS 7.
legacy-peer-deps=true
